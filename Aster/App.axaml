<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aster.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Aster/Styles/Palette.axaml" />
                <ResourceInclude Source="avares://Aster/Styles/Icons.axaml" />
                <ResourceInclude Source="avares://Aster/Styles/ControlThemes.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Aster/Styles/Styles.axaml" />
    </Application.Styles>
</Application>

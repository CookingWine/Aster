<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Aster.Controls"
        xmlns:m="using:Aster.Models"
        x:Class="Aster.Views.NowPlayingWindow"
        Title="正在播放 · Aster"
        Width="1180" Height="800"
        MinWidth="1020" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        WindowDecorations="BorderOnly">

    <Grid RowDefinitions="56,*" ClipToBounds="True">

        <!-- 光晕：左下紫、右上玫瑰 -->
        <Border Width="1100" Height="900" Background="{StaticResource AuraPurple}"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-240,0,0,60"
                IsHitTestVisible="False" />
        <Border Width="1000" Height="900" Background="{StaticResource AuraRose}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-420,-120,0"
                IsHitTestVisible="False" />

        <!-- ==================== 顶栏 ==================== -->
        <Grid Name="Header" Grid.Row="0" Margin="26,0" ColumnDefinitions="Auto,Auto,*,Auto">
            <c:AsterButton Classes="icon" Width="30" Height="30" CornerRadius="15" Click="OnBack"
                           ToolTip.Tip="返回">
                <c:Icon Kind="Back" Width="18" Height="18" Tint="{StaticResource NavTextHover}" />
            </c:AsterButton>
            <TextBlock Grid.Column="1" Text="正在播放" FontSize="12.5" Foreground="#8B80A8"
                       VerticalAlignment="Center" Margin="14,0,0,0" />
            <c:TrafficLights Grid.Column="3" VerticalAlignment="Center" />
        </Grid>

        <!-- ==================== 主体 ==================== -->
        <Grid Grid.Row="1" ColumnDefinitions="420,*" ColumnSpacing="140" Margin="100,52,100,40">

            <!-- 左：封面与控制 -->
            <StackPanel>
                <Border Width="420" Height="420" CornerRadius="22" ClipToBounds="True"
                        BorderBrush="#5A3A78" BorderThickness="1"
                        BoxShadow="0 40 90 -40 #E6000000">
                    <Grid>
                        <Border Background="{StaticResource NpArtBg}" />
                        <Border Background="{StaticResource NpArtGlow}" />
                        <Border Width="134" Height="134" CornerRadius="67" BorderBrush="#42FFFFFF"
                                BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock Text="山茶夜语" FontSize="34" FontWeight="Bold" LetterSpacing="-0.7"
                           Margin="0,26,0,8" />
                <TextBlock Text="Aster Studio · 深夜紫调" FontSize="13.5"
                           Foreground="#8B80A8" />

                <!-- 进度 -->
                <Grid Margin="0,30,0,0">
                    <Border Height="3" CornerRadius="2" Background="#2A2046">
                        <Grid ColumnDefinitions="43*,57*">
                            <Border CornerRadius="2" Background="{StaticResource ProgressRose}">
                                <Ellipse Width="10" Height="10" Fill="White"
                                         HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Margin="0,0,-5,0" />
                            </Border>
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,*" Margin="0,15,0,0">
                        <TextBlock Text="1:42" FontSize="11" Foreground="{StaticResource Text3}" />
                        <TextBlock Grid.Column="1" Text="4:38" FontSize="11"
                                   Foreground="{StaticResource Text3}" HorizontalAlignment="Right" />
                    </Grid>
                </Grid>

                <!-- 传输控制 -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="26"
                      Margin="0,28,0,0">
                    <c:AsterButton Classes="icon" ToolTip.Tip="随机播放">
                        <c:Icon Kind="Shuffle" Width="18" Height="18" Tint="#8B80A8" />
                    </c:AsterButton>
                    <c:AsterButton Grid.Column="1" Classes="icon" ToolTip.Tip="上一首">
                        <c:Icon Kind="Prev" Width="18" Height="18" Tint="#8B80A8" />
                    </c:AsterButton>

                    <c:AsterButton Grid.Column="2" Name="PlayToggle" Width="64" Height="64" CornerRadius="32"
                                   Background="{StaticResource Purple}" Click="OnTogglePlay"
                                   ToolTip.Tip="播放 / 暂停">
                        <Panel>
                            <c:Icon Name="PlayIcon" Kind="Play" Width="22" Height="22" Tint="White" />
                            <c:Icon Name="PauseIcon" Kind="Pause" Width="22" Height="22" Tint="White"
                                    IsVisible="False" />
                        </Panel>
                    </c:AsterButton>

                    <c:AsterButton Grid.Column="3" Classes="icon" ToolTip.Tip="下一首">
                        <c:Icon Kind="Next" Width="18" Height="18" Tint="#8B80A8" />
                    </c:AsterButton>
                    <c:AsterButton Grid.Column="4" Classes="icon" ToolTip.Tip="循环">
                        <c:Icon Kind="Repeat" Width="18" Height="18" Tint="#8B80A8" />
                    </c:AsterButton>

                    <c:AsterButton Grid.Column="6" Classes="icon liked" Click="OnToggleLike" ToolTip.Tip="喜欢">
                        <c:Icon Kind="Heart" Width="18" Height="18" Tint="{StaticResource Rose}" Weight="1.9" />
                    </c:AsterButton>
                </Grid>
            </StackPanel>

            <!-- 右：歌词与队列 -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="歌词 · LYRICS" FontSize="10" FontWeight="Medium"
                               LetterSpacing="2" Foreground="{StaticResource Text4}" />

                    <StackPanel Spacing="18" Margin="32,26,0,0">
                        <TextBlock Text="夜色落在山茶的花瓣上" FontSize="17" Foreground="#4E4568" />
                        <TextBlock Text="我把心事调成了低频" FontSize="17" Foreground="#4E4568" />
                        <TextBlock Text="雨声比我先学会了停顿" FontSize="17" Foreground="#4E4568" />

                        <Grid ColumnDefinitions="Auto,*" Margin="-32,0,0,0">
                            <Border Width="3" Height="26" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{StaticResource PurpleGlow}" />
                            <TextBlock Grid.Column="1" Text="让紫色的光替我呼吸" FontSize="24"
                                       FontWeight="Medium" Foreground="White" LetterSpacing="-0.3"
                                       Margin="29,0,0,0" />
                        </Grid>

                        <TextBlock Text="你的名字在副歌里循环" FontSize="17" Foreground="#6B6088" />
                        <TextBlock Text="我在等一句迟到的回答" FontSize="17" Foreground="#4E4568" />
                        <TextBlock Text="房间只剩下回声" FontSize="17" Foreground="#4E4568" />
                    </StackPanel>

                    <!-- 接下来播放 -->
                    <Border Margin="0,34,0,0" Padding="0,20,0,0"
                            BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                                <TextBlock Text="接下来播放" FontSize="12" FontWeight="Medium"
                                           Foreground="#8B80A8" />
                                <TextBlock Grid.Column="1" Text="3 首" FontSize="11"
                                           Foreground="{StaticResource Text4}" />
                            </Grid>

                            <ItemsControl ItemsSource="{x:Static m:SampleData.UpNext}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="38,*,Auto" Height="56">
                                            <Border Width="38" Height="38" CornerRadius="8" ClipToBounds="True"
                                                    VerticalAlignment="Center">
                                                <Panel>
                                                    <Border CornerRadius="8" Background="{Binding Art.Fill}" />
                                                    <Border CornerRadius="8" Background="{Binding Art.Glow}" />
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" />
                                                <TextBlock Text="{Binding Artist}" FontSize="10.5" Margin="0,2,0,0"
                                                           Foreground="{StaticResource Text4}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Duration}" FontSize="11"
                                                       Foreground="{StaticResource Text4}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
